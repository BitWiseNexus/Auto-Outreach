# ============================================================================
# AutoOutreach configuration  --  copy to `.env` and fill in.
#   cp .env.example .env      (PowerShell: Copy-Item .env.example .env)
# Every service below has a FREE tier. No paid API is required anywhere.
# ============================================================================

# ---------------------------------------------------------------------------
# 1) LLM providers
# ---------------------------------------------------------------------------
# PRIMARY: Groq -- free API key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# FALLBACK: Google Gemini -- free API key at https://aistudio.google.com/apikey
# Used automatically if Groq errors out, rate-limits, or returns junk.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---------------------------------------------------------------------------
# 2) Gmail SMTP (free -- uses your normal Gmail account + an App Password)
#    App Password: https://myaccount.google.com/apppasswords  (needs 2FA on)
#    Paste the 16-char password; spaces are stripped automatically.
# ---------------------------------------------------------------------------
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=
SENDER_NAME=Name

# Optional: where --test sends its single sanity-check email.
# Defaults to GMAIL_ADDRESS if left blank.
TEST_RECIPIENT=

# Optional: Reply-To header. Defaults to GMAIL_ADDRESS if left blank.
REPLY_TO=

# ---------------------------------------------------------------------------
# 3) Sending guardrails
# ---------------------------------------------------------------------------
# Random delay between sends, in seconds (looks human, protects reputation).
SEND_DELAY_MIN=45
SEND_DELAY_MAX=60

# Hard cap on emails sent per calendar day (across all runs of that day).
DAILY_SEND_CAP=40

# ---------------------------------------------------------------------------
# 4) Files & paths (relative to the project root; defaults are fine)
# ---------------------------------------------------------------------------
CONTACTS_CSV=companies.csv
PROFILE_JSON=profile.json
SENT_LOG_CSV=sent_log.csv
OUTBOX_DIR=outbox
LOG_DIR=logs

# ---------------------------------------------------------------------------
# 5) Email generation tuning
# ---------------------------------------------------------------------------
# Max words allowed in the generated body (signature block excluded).
MAX_BODY_WORDS=120

# Retry/backoff for LLM calls (per provider).
LLM_MAX_RETRIES=4
LLM_BACKOFF_BASE=2.0
